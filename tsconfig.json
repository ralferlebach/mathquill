{
  "exclude": ["test/e2e", "playwright.config.ts", "node_modules", "build"],
  "compilerOptions": {
    "noImplicitThis": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "strictPropertyInitialization": false,
    "strict": true,
    "target": "ES5",
    "lib": ["ES5", "ScriptHost", "DOM", "ES2015.Collection"],
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "tslib": ["node_modules/tslib/tslib"]
    },
    "importHelpers": true,
    "noEmit": true,
    "pretty": true,
    "typeRoots": ["./node_modules/@types"],
    // Explicit: @types/node is only for the Playwright suites, which are
    // compiled through test/e2e/tsconfig.json.
    "types": ["mocha"]
  }
}
